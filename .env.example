# Sao chép thành .env.local khi chạy máy cục bộ. KHÔNG commit giá trị thật.
# Khi nối Supabase qua Vercel Marketplace, Vercel tự thêm biến này vào project.
DATABASE_URL=
# Hoặc POSTGRES_URL (Vercel tự thêm khi nối Supabase). Trên Vercel dùng chuỗi qua pooler (IPv4), không dùng host db.<mã>.supabase.co trực tiếp (chỉ IPv6).

# Tùy chọn: PEM của CA gốc khi dùng Postgres khác Supabase. Mặc định nạp CA gốc của Supabase (lib/supabase-ca.ts).
# Ứng dụng luôn kiểm chứng chỉ TLS; không có chế độ tắt kiểm tra.
DATABASE_CA=

# Khóa công khai (publishable) của Supabase, an toàn để lộ ở trình duyệt. KHÔNG đặt khóa secret/service_role ở đây.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Tùy chọn: nếu đặt, /api/cron/keepalive chỉ nhận lời gọi có "Authorization: Bearer <giá trị này>" (Vercel cron tự gửi).
CRON_SECRET=
